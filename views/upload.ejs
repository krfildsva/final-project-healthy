<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/edit.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <title>Upload Image</title>
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg bg-body-tertiary fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="#"></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Starter Page</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/signup">Sign up</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard">Main Page</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/nutrition">Nutrition</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/recipes">Recipes</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
  <div class="container">
    <h1>Upload Image</h1>
    <form action="/upload" method="post" enctype="multipart/form-data">
      <div class="mb-3">
      <label for="formFile" class="form-label">Image</label>
      <span class="btn btn-light">
        Browse   
      <input type="file" id="formFile" name="image" required></span>
    </div>
    <div class="mb-3">
      <label for="naming" class="form-label">Name</label>
      <input type="text" name="naming" class="form-control" required>
    </div>
    <div class="mb-3">
      <label for="text" class="form-label">Description</label>
      <input type="text" name="text" class="form-control" placeholder="Enter image description" required>
    </div>
      <button type="submit" class="btn btn-light">Upload Image</button>
  </form>
      <hr>
      <div class="row">
        <div class="col-sm-12">
          <div class="preview-images"></div>
        </div>
      </div>
      </div>
  <footer class="text-center text-lg-start bg-body-tertiary text-muted fixed-bottom">
    <div class="container-sm">
    <h5>Saltanat Korfildesova</h5>
    <h5>IT-2204</h5>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</div>
</footer>
</body>
</html>
